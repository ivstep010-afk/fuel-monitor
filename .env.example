# GdeBenz Monitor - Пример конфигурации
# Скопируйте в .env и заполните свои значения

# === Telegram уведомления (опционально) ===
# Получите токен у @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Узнайте свой Chat ID у @userinfobot: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# === Настройки API (обычно не нужно менять) ===
# Базовый URL API gdebenz.ru
GDEBENZ_API_URL=https://gdebenz.ru/api

# Интервал проверки в секундах (по умолчанию 300 = 5 минут)
# Не ставьте меньше 60 секунд чтобы не получить бан
GDEBENZ_UPDATE_INTERVAL=300

# Таймаут запроса в секундах
GDEBENZ_REQUEST_TIMEOUT=30